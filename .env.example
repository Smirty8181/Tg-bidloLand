# Telegram
BOT_TOKEN=
WEBAPP_URL=https://your-domain.example
BACKEND_URL=http://127.0.0.1:8080
NEWS_CHANNEL_ID=

# Database (PostgreSQL in production)
# postgresql+asyncpg://bydlo:password@127.0.0.1:5432/bydloland
DATABASE_URL=sqlite+aiosqlite:///./data/bydloland.db

# RCON (never expose to Telegram clients)
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# Minecraft Paper plugin bridge
PLUGIN_API_URL=http://127.0.0.1:8765
PLUGIN_API_KEY=

# Internal bot <-> backend key
INTERNAL_API_KEY=

# Web map (Dynmap / BlueMap / squaremap)
MAP_URL=https://map.bydloland.example

# Builds (admin can override in database)
BUILD_WINDOWS_URL=
BUILD_ZIP_URL=
BUILD_VERSION=1.21.10
BUILD_WINDOWS_SIZE=
BUILD_ZIP_SIZE=

# Server
SERVER_NAME=БыдлоЛенд
SERVER_VERSION=1.21.10
SERVER_MAX_PLAYERS=100
MINIAPP_TITLE=БыдлоЛенд

# Bootstrap: comma-separated Telegram IDs promoted to head_admin on startup
HEAD_ADMIN_TELEGRAM_IDS=

# Hosting-Minecraft panel (mgr.hosting-minecraft.pro)
HOSTING_PANEL_URL=https://mgr.hosting-minecraft.pro
HOSTING_SERVER_ID=09390ef6
HOSTING_API_KEY=
MINECRAFT_SERVER_HOST=

# Optional
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
APP_ENV=prod
DEV_TELEGRAM_ID=
DEV_USERNAME=
